{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train Actor-Critic (Confounded)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/train_actor_critic.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--env-id",
        "CausalContrastive-WindyCorridor-15x15-Lethal-v0",
        "--num-episodes",
        "50",
        "--num-steps",
        "20000",
        "--lam",
        "0.5",
        "--critic-warmup",
        "2000"
      ]
    },
    {
      "name": "Train Actor-Critic (Oracle)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/train_actor_critic.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--env-id",
        "CausalContrastive-WindyCorridor-15x15-Lethal-v0",
        "--oracle-state",
        "--num-episodes",
        "50",
        "--num-steps",
        "20000",
        "--lam",
        "0.5",
        "--critic-warmup",
        "2000"
      ]
    },
    {
      "name": "Eval Actor (Confounded -> CSV)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/evaluate_actor_forced_u.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--checkpoint",
        "checkpoints/actor_critic_confounded_seed0_CausalContrastive_WindyCorridor_15x15_Lethal_v0_oracle_eps.npz",
        "--eval-env-id",
        "CausalContrastive-WindyCorridor-15x15-Lethal-v0",
        "--episodes-per-regime",
        "50",
        "--output",
        "results/actor_confounded_forced_u.csv"
      ]
    },
    {
      "name": "Eval Actor (Oracle -> CSV)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/evaluate_actor_forced_u.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--checkpoint",
        "checkpoints/actor_critic_oracle_seed0_CausalContrastive_WindyCorridor_15x15_Lethal_v0_oracle_eps.npz",
        "--eval-env-id",
        "CausalContrastive-WindyCorridor-15x15-Lethal-v0",
        "--episodes-per-regime",
        "50",
        "--output",
        "results/actor_oracle_forced_u.csv"
      ]
    },
    {
      "name": "Eval Actor (Confounded, stdout only quick)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/evaluate_actor_forced_u.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--checkpoint",
        "checkpoints/actor_critic_confounded_seed0_CausalContrastive_WindyCorridor_15x15_Lethal_v0_oracle_eps.npz",
        "--eval-env-id",
        "CausalContrastive-WindyCorridor-15x15-Lethal-v0",
        "--episodes-per-regime",
        "20",
        "--stdout-only"
      ]
    },
    {
      "name": "Eval Actor (Oracle, stdout only quick)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/evaluate_actor_forced_u.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--checkpoint",
        "checkpoints/actor_critic_oracle_seed0_CausalContrastive_WindyCorridor_15x15_Lethal_v0_oracle_eps.npz",
        "--eval-env-id",
        "CausalContrastive-WindyCorridor-15x15-Lethal-v0",
        "--episodes-per-regime",
        "20",
        "--stdout-only"
      ]
    }
  ]
}
